<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The UI kit of Aura Operating System as a library: components, the skin
    engine and the layout tree, over Cosmos.Kernel.System's Canvas. Any Cosmos
    gen3 kernel can reference it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- The code comes from Aura, which is not annotated for nullable reference types. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Aura.UI</RootNamespace>
  </PropertyGroup>

  <!--
    Not packed yet. The Aura.UI on nuget.org is another library (controls for
    Avalonia) with a 0.1.0 of its own: a package under this ID, restored by a
    kernel that also reads nuget.org, could be taken for that one. The package
    needs an ID of its own first.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PackageId>Aura.UI</PackageId>
    <Version>0.1.0</Version>
    <Authors>Aura Team</Authors>
    <Description>The UI kit of Aura Operating System for Cosmos gen3 kernels: skinned components, layout and input.</Description>
    <PackageTags>cosmos;aura;ui;gui;kernel</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The licenses of what the package carries travel with it. -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE.md" Pack="true" PackagePath="/" />
    <None Include="Parser/LICENSE.md" Pack="true" PackagePath="/licenses/NanoXML/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel.System" Version="$(CosmosVersion)" />
  </ItemGroup>

  <!-- Every file under Resources/ is embedded as "Aura.UI/<path under Resources, '/'-separated>". -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*">
      <LogicalName>Aura.UI/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
